{
  "name": "slide",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "slidev build",
    "dev": "slidev --open",
    "export": "slidev export",
    "export:all": "for f in slides/*.md; do slidev export \"$f\" --output \"../pdf/$(basename \"$f\" .md).pdf\"; done"
  },
  "dependencies": {
    "@slidev/cli": "^52.15.2",
    "@slidev/theme-default": "latest",
    "@slidev/theme-seriph": "latest",
    "slidev-theme-tut": "github:micanis/slidev-theme-tut",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "playwright-chromium": "^1.60.0"
  }
}
